rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Пользователи: чтение — любой авторизованный, запись — только свой документ
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Встречи: авторизованные пользователи могут читать/писать,
    // если他们是 участниками встречи (participantIds содержит uid)
    // или являются учителем (teacherId == uid)
    match /meetings/{meetingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }
  }
}
