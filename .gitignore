# --- Персональное / секреты / генерируемое ---

# Firebase клиентские конфиги (содержат ключи проекта, не храним в репо).
# Восстанавливаются командой  flutterfire configure
# (пересоздаёт google-services.json, GoogleService-Info.plist, firebase_options.dart)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
lib/core/config/firebase_options.dart

# Секреты и ключи (служебные аккаунты, .env, keystore)
.env
.env.*
**/.flutter-plugins
**/firebase-export/
*.jks
*.keystore
key.properties
**/key.properties
*service_account*.json
*ServiceAccount*.json
*.p12
*.p8
*.pem
!**/test/*.pem

# CocoaPods (генерируются из Podfile.lock, который храним в репо)
ios/Pods/
macos/Pods/

# Эфемерные/генерируемые файлы Flutter-платформ
ios/.symlinks/
ios/Flutter/ephemeral/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
macos/.symlinks/
macos/Flutter/ephemeral/
